{
	"name": "gavel",
	"version": "1.0.0",
	"private": true,
	"description": "AI evaluation operations platform — React and Django",
	"workspaces": [
		"frontend"
	],
	"scripts": {
		"prestart": "node scripts/run-setup.mjs --start",
		"start": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\"",
		"dev:frontend": "cd frontend && bun run dev",
		"dev:backend": "node scripts/run-backend.mjs",
		"seed": "node scripts/run-seed.mjs",
		"worker": "node scripts/run-worker.mjs",
		"test": "node scripts/run-tests.mjs",
		"test:e2e": "node e2e/gavel.spec.js"
	},
	"devDependencies": {
		"concurrently": "9.2.1"
	}
}
