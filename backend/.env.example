# Gavel Environment Variables
# Copy this file to .env and fill in all secrets before deploying.
# NEVER commit .env to version control.

# Node environment: development or production
NODE_ENV=development

# Django port
PORT=8000

# MongoDB connection URI (use TLS/SSL in production)
MONGODB_URI=mongodb://127.0.0.1:27017/gavel_db

# Production secret requirements:
# - Must be at least 32 characters
# - Must contain no "demo", "local", or test strings
# - Must be unique per environment
DJANGO_SECRET_KEY=generate-a-strong-random-secret-here

# JWT settings
# JWT_SECRET: production must not contain "demo" or "local"
JWT_SECRET=generate-a-strong-random-jwt-secret-here
JWT_ISSUER=gavel-api
JWT_AUDIENCE=gavel-app
# JWT lifetime in seconds: 7200 (2h) for production; 86400 (24h) for development only
JWT_LIFETIME_SECONDS=7200

# Vite / frontend
VITE_API_URL=/api/v1

# Production CORS origins (comma-separated, no spaces)
# Example: CORS_ALLOWED_ORIGINS=http://localhost:3000,https://gavel.example.com
CORS_ALLOWED_ORIGINS=

# Rate limiting (optional: set lower for stricter limits)
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100
# Empty by default: ignore forwarded IP headers from untrusted peers.
# Example for a controlled loopback reverse proxy: 127.0.0.1/32,::1/128
TRUSTED_PROXY_CIDRS=
